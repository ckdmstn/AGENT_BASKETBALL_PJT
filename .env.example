# Copy this file to .env and fill in your local credentials.

# OpenAI-compatible LLM (use the provider's API base URL and model ID).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Kakao Local and KMA short-term forecast credentials.
KAKAO_REST_API_KEY=
KMA_SERVICE_KEY=

# Optional settings shown with their application defaults.
KBL_BASE_URL=https://api.kbl.or.kr
KBL_TEAM_CODE=XX
API_TIMEOUT_SECONDS=15
